<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/verhalenbank/Ontologie#"
     xml:base="http://example.org/verhalenbank/Ontologie"
     xmlns:vb="http://example.org/verhalenbank/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/verhalenbank/Ontologie">
        <rdfs:label xml:lang="nl">Ontologie van Nederlandse volksverhalen</rdfs:label>
        <rdfs:label xml:lang="fy">Ontology fan Nederlânske folksferhalen</rdfs:label>
        <rdfs:label xml:lang="de">Ontologie niederlandischer Volkserzahlungen</rdfs:label>
        <rdfs:label xml:lang="en">Ontology of Dutch folk tales</rdfs:label>
    </owl:Ontology>
    


