    <!-- http://example.org/verhalenbank/appearsIn -->

    <owl:ObjectProperty rdf:about="http://example.org/verhalenbank/appearsIn">
        <rdfs:domain rdf:resource="http://example.org/verhalenbank/Character"/>
        <rdfs:range rdf:resource="http://example.org/verhalenbank/Story"/>
        <rdfs:label xml:lang="nl">karakter komt voor in verhaal</rdfs:label>
        <rdfs:label xml:lang="fy">personaazje komt foar yn ferhaal</rdfs:label>
        <rdfs:label xml:lang="de">Charakter kommt in Geschichte vor</rdfs:label>
        <rdfs:label xml:lang="en">character appears in story</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/verhalenbank/defeats -->

    <owl:ObjectProperty rdf:about="http://example.org/verhalenbank/defeats">
        <rdfs:domain rdf:resource="http://example.org/verhalenbank/Character"/>
        <rdfs:range rdf:resource="http://example.org/verhalenbank/Character"/>
        <rdfs:label xml:lang="nl">karakter verslaat of misleidt ander karakter</rdfs:label>
        <rdfs:label xml:lang="fy">personaazje ferslacht of ferrifelt in oar personaazje</rdfs:label>
        <rdfs:label xml:lang="de">Charakter besiegt oder täuscht einen anderen Charakter</rdfs:label>
        <rdfs:label xml:lang="en">character defeats or deceives another character</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/verhalenbank/discoversLocation -->

